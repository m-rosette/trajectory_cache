    <parent link="base_link" />
    <child link="base" />
  </joint>
  <!-- Frame coincident with all-zeros TCP on UR controller -->
  <link name="tool0" />
  <joint name="wrist_3_link-tool0_fixed_joint" type="fixed">
    <origin rpy="-1.57079632679 0 0" xyz="0 0.1 0" />
    <parent link="wrist_3_link" />
    <child link="tool0" />
  </joint>

  <!-- ============================================================================== -->
  <!--  Suction gripper end-of-arm tooling (expanded from the gripper_macro xacro).     -->
  <!--  tool0 frame: +z out of the flange, -y = ejector side. Units: m, rad.           -->
  <!--  gripper_link is the gripper TIP, 0.25 m out from the flange.                   -->
  <!-- ============================================================================== -->
  <joint name="gripper_joint" type="fixed">
    <parent link="tool0" />
    <child link="gripper_link" />
    <origin xyz="0 0 0.25" rpy="0 0 0" />
  </joint>

  <!-- Gripper body: 7 x 7 cm square prism, 24 cm long, spanning z 0.01-0.25 from the flange.
       Box center is 0.12 behind the tip: 0.25 - (0.01 + 0.24/2) = 0.12 -->
  <link name="gripper_link">
    <collision>
      <origin xyz="0 0 -0.12" rpy="0 0 0" />
      <geometry>
        <box size="0.07 0.07 0.24" />
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 -0.12" rpy="0 0 0" />
      <geometry>
        <box size="0.07 0.07 0.24" />
      </geometry>
      <material name="gripper_aluminum">
        <color rgba="0.5 0.5 0.5 1" />
      </material>
    </visual>
  </link>

  <!-- Ejector plate: 22 (x) x 14 (y) x 2.5 (z) cm, flush on the flange (z 0-0.025),
       on the -y side (y -0.0475 to -0.1875). Origin is the plate center. -->
  <joint name="ejector_joint" type="fixed">
    <parent link="tool0" />
    <child link="ejector_link" />
    <origin xyz="0 -0.1175 0.0125" rpy="0 0 0" />
  </joint>

  <link name="ejector_link">
    <collision>
      <geometry>
        <box size="0.22 0.14 0.025" />
      </geometry>
    </collision>
    <visual>
      <geometry>
        <box size="0.22 0.14 0.025" />
      </geometry>
      <material name="gripper_aluminum">
        <color rgba="0.5 0.5 0.5 1" />
      </material>
    </visual>
  </link>

  <!-- Reference frames, offsets from gripper_link (the tip); negative z = back toward the flange -->
  <!-- Suction cups: 19.5 cm from the flange; -150 deg yaw lines up with the cup pattern -->
  <joint name="gripper_scups_joint" type="fixed">
    <parent link="gripper_link" />
    <child link="gripper_scups_link" />
    <origin xyz="0.00 0.00 -0.055" rpy="0 0 -2.618" />
  </joint>

  <link name="gripper_scups_link" />

  <!-- Palm camera optical frame: 16.5 cm from the flange, on the tool axis -->
  <joint name="gripper_palm_camera_joint" type="fixed">
    <parent link="gripper_link" />
    <child link="gripper_palm_camera_optical_link" />
    <origin xyz="0.00 0 -0.085" rpy="0 0 0" />
  </joint>

  <link name="gripper_palm_camera_optical_link" />

  <!-- Top camera: 12.85 cm from the flange, 7.2 cm toward -y (the ejector side) -->
  <joint name="gripper_top_camera_joint" type="fixed">
    <parent link="gripper_link" />
    <child link="gripper_top_camera_link" />
    <origin xyz="0.00 -0.072 -0.1215" rpy="0 0 0" />
  </joint>

  <link name="gripper_top_camera_link" />
